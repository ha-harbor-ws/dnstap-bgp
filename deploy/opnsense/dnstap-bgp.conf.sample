# OPNsense 26.7 / FreeBSD 15 sample configuration
# Installed as /usr/local/etc/dnstap-bgp/dnstap-bgp.conf
#
# Enable:
#   sysrc dnstap_bgp_enable=YES
#   service dnstap_bgp start
#
# Default startup uses a VNET jail (FreeBSD analog of Linux ip netns) with
# host 192.168.113.1/30 and jail 192.168.113.2/30. Point FRR/BIRD at the
# jail address and set sourceIP/nextHop below to that address.

# One FQDN per line, lowercase. IDN/punycode is not supported.
# If a name matches both lists, proxy wins.
proxy_domains = "/usr/local/etc/dnstap-bgp/proxy.txt"
direct_domains = "/usr/local/etc/dnstap-bgp/direct.txt"

# BoltDB cache
cache = "/var/db/dnstap-bgp/cache.db"

ttl = "24h"
ipv6 = false

[dnstap]
# UNIX socket is on the shared filesystem; Unbound on the host can write here.
listen = "/var/run/dnstap-bgp/dnstap.sock"
perm = "0666"

[bgp]
as = 65000
routerID = "192.168.113.2"
sourceIP = "192.168.113.2"
nextHop = "192.168.113.2"
# FRR/BIRD on the host epair address (see rc.conf.d/dnstap_bgp)
peers = [
    "192.168.113.1",
]

# Communities for prefixes resolved from proxy_domains
# Standard ASN:VALUE, large ASN:A:B, or well-known (no-export, blackhole, ...)
proxy_communities = [
    "65000:666",
]

# Communities for prefixes resolved from direct_domains
direct_communities = [
    "65000:100",
]

# Optional HTTP(S) sync. Token is required if this section is enabled.
# [syncer]
# listen = "0.0.0.0:8080"
# token = "change-me"
# tlsCert = "/usr/local/etc/dnstap-bgp/sync.crt"
# tlsKey = "/usr/local/etc/dnstap-bgp/sync.key"
# tlsInsecureSkipVerify = false
# syncInterval = "10m"
# peers = [
#     "192.168.0.2:8080",
# ]
